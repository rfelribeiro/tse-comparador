{
  "name": "tse-comparador",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "data:fetch": "tsx scripts/fetch.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:validate": "tsx scripts/validate.ts",
    "data:geo": "tsx scripts/build-geo.ts",
    "data": "npm run data:fetch && npm run data:build && npm run data:validate",
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "preview": "npm run preview -w app",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mapshaper": "^0.7.98",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
